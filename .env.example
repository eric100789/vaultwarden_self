# 複製成 .env 後填入實際值：cp .env.example .env
# .env 含有機密，已被 .gitignore 排除，不要 commit！

# ===== 基本 =====
# 你的 Vaultwarden 對外網址（Cloudflare 上設定的子網域）
DOMAIN=https://vault.example.com

# Vaultwarden 綁在伺服器本機的 port（只綁 127.0.0.1，不對外）。
# 跟其他 docker app 衝突就改成任何沒被占用的數字。
VW_PORT=8200

TZ=Asia/Taipei

# ===== Cloudflare Tunnel =====
# 從 Cloudflare Zero Trust 後台建立 Tunnel 後拿到的 token（很長的一串）
TUNNEL_TOKEN=

# ===== 註冊控制 =====
# false = 關閉公開註冊（預設，建議）。要臨時開放時改 true 再 docker compose up -d
SIGNUPS_ALLOWED=false
# true = 允許從 admin 後台寄邀請信給別人（建議的分享方式）
INVITATIONS_ALLOWED=true
# true = 新帳號需要點 Email 驗證信才能用（需 SMTP 正常）
SIGNUPS_VERIFY=true

# ===== admin 後台 =====
# 必須是 argon2 雜湊值，產生方式（在伺服器上執行，輸入你想要的後台密碼）：
#   docker run --rm -it vaultwarden/server /vaultwarden hash
# 注意：雜湊值裡有很多 $ 符號，整串「一定要用單引號包起來」，否則會被 compose 當成變數吃掉。
# 範例格式： ADMIN_TOKEN='$argon2id$v=19$m=65540,t=3,p=4$xxxxxxxx$yyyyyyyy'
ADMIN_TOKEN=''

# ===== SMTP（Gmail）=====
# 需先在 Google 帳號開啟兩步驟驗證，再到 https://myaccount.google.com/apppasswords
# 產生 16 碼「應用程式密碼」（不是你的 Gmail 登入密碼）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=your.account@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
SMTP_FROM=your.account@gmail.com
SMTP_FROM_NAME=Vaultwarden
